def linkRepresentative (i : Fin 68) : Family (Fin 12) := linkCatalogue[i.val]!

def embed11 : Fin 11 ↪ Fin 12 :=
  ⟨fun q => ⟨q.val, Nat.lt_trans q.isLt (by decide)⟩,
   fun _ _ h => Fin.ext (congrArg (fun z : Fin 12 => z.val) h)⟩

def decodeGPPT (tag : Bool) (x : BitVec 88) : Family (Fin 12) :=
  ((stantonRepresentative tag).image (fun B => insert (11 : Fin 12) (B.map embed11))) ∪
  ((Finset.univ.image (fun r : Fin 8 =>
    (decode (x.extractLsb' (11*r.val) 11)).map embed11)).erase ∅)

def permutation48 (w : BitVec 48) (q : Fin 12) : Fin 12 :=
  ⟨(w.extractLsb' (4*q.val) 4).toNat % 12, Nat.mod_lt _ (by decide)⟩

def goodGPPTWitness (tag : Bool) (w : BitVec 88 × Fin 68 × BitVec 48) : Prop :=
  Function.Injective (permutation48 w.2.2) ∧
  (decodeGPPT tag w.1).image (fun B => B.image (permutation48 w.2.2)) =
    linkRepresentative w.2.1 ∧ (decodeGPPT tag w.1).card = 15

end CoveringDesigns
