  have hr : selectorInverseCheck 3 rows ownerIndex rows = true := by
    change (part0 ++ part1 ++ part2 ++ part3 ++ part4).all _ = true
    simp only [List.all_append, Bool.and_eq_true]
    exact ⟨⟨⟨⟨reverse0,reverse1⟩,reverse2⟩,reverse3⟩,reverse4⟩
