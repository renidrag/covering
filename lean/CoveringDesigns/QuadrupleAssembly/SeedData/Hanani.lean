theorem checked : selectorDesignCheck (fun x : Fin 18 => x.val / 3) 4 3 rows ownerIndex = true := by
  have hc : selectorCoverCheck (fun x : Fin 18 => x.val / 3) 3 rows ownerIndex = true := by
    apply selectorCoverCheck_of_slices (fun x : Fin 18 => x.val / 3) 3 rows ownerIndex (by decide)
    intro a
    fin_cases a
    · exact forward0
    · exact forward1
    · exact forward2
